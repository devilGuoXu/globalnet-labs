---
import Layout from '../layouts/Layout.astro';
---

<Layout title="联系我们 - GlobalNet Labs">
  <div class="max-w-[1440px] mx-auto px-6 py-12">
    <h1 class="text-3xl font-bold text-slate-100 mb-3">联系我们</h1>
    <p class="text-slate-400 mb-10">如有合作、建议或问题，欢迎与我们取得联系。</p>

    <div class="bg-slate-900 border border-slate-800 rounded-xl p-8 max-w-2xl">
      <p class="text-slate-400 mb-6">请通过以下方式联系我们：</p>
      <div class="space-y-4">
        <div class="flex items-center gap-3 text-sm">
          <svg class="w-5 h-5 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          <span class="text-slate-300">邮箱：contact@globalnetlabs.com</span>
        </div>
        <div class="flex items-center gap-3 text-sm">
          <svg class="w-5 h-5 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          <span class="text-slate-300">地址：上海市浦东新区</span>
        </div>
      </div>
    </div>
  </div>
</Layout>
