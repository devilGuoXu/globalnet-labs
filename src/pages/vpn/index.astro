---
import Layout from '../../layouts/Layout.astro';
import vpnsData from '../../data/vpns.json';
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<Layout title="虚拟专用网络 (VPN) 厂商全览 - GlobalNet Labs">
  <div class="max-w-[1440px] mx-auto px-6 py-12">
    <div class="flex items-start justify-between gap-4 mb-6 flex-wrap">
      <div>
        <h1 class="text-3xl md:text-4xl font-bold text-slate-100 mb-2">虚拟专用网络 (VPN) 厂商全览</h1>
        <p class="text-slate-400 text-sm">精选全球优质虚拟专用网络服务，涵盖加密隧道协议、隐私保护与无日志策略对比。</p>
      </div>
      <div class="flex items-center gap-3 shrink-0">
        <div class="relative">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <input id="search-input" type="text" placeholder="搜索 VPN 名称..." class="w-52 bg-slate-800 border border-slate-700 rounded-lg pl-10 pr-4 py-2 text-sm text-slate-200 placeholder-slate-500 focus:outline-none focus:border-emerald-500 transition-colors" />
        </div>
        <span class="text-xs text-slate-500 whitespace-nowrap">共 <span id="total-count">{vpnsData.length}</span> 家厂商</span>
      </div>
    </div>

    <div id="vpn-grid" class="grid md:grid-cols-2 gap-4">
      {vpnsData.sort((a, b) => b.rating - a.rating).map((vpn) => {
        const isExternal = vpn.detailUrl.startsWith('http');
        return (
          <div class="vpn-card" data-name={vpn.name.toLowerCase()}>
            <a href={isExternal ? vpn.detailUrl : `${base}${vpn.detailUrl}`} target={isExternal ? '_blank' : undefined} rel={isExternal ? 'noopener noreferrer' : undefined} class="bg-slate-900 border border-slate-800 rounded-xl p-5 hover:border-emerald-500/30 transition-all duration-300 group block">
              <div class="flex items-start justify-between mb-3">
                <div class="flex items-center gap-3">
                  <h3 class="text-base font-semibold text-slate-100 group-hover:text-emerald-400 transition-colors">{vpn.name}</h3>
                  {vpn.badge && (
                    <span class="text-xs text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-full border border-emerald-500/20">{vpn.badge}</span>
                  )}
                </div>
                <span class="flex items-center gap-1 text-amber-400 text-sm shrink-0">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                  {vpn.rating}
                </span>
              </div>
              <p class="text-sm text-slate-400 mb-3"><span class="text-slate-500">管辖地：</span>{vpn.jurisdiction} · {vpn.protocols?.join('、')}</p>
              <div class="flex gap-4 mb-4">
                <ul class="space-y-1 flex-1">
                  {vpn.features.slice(0, 4).map((f) => (
                    <li class="flex items-center gap-2 text-sm text-slate-300">
                      <svg class="w-3.5 h-3.5 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                      {f}
                    </li>
                  ))}
                </ul>
                <div class="shrink-0 flex items-center justify-center">
                  <img src={`${base}/images/${vpn.id}.${['getfoxyproxy','okayvpn','surfshark','highproxies','expressvpn','proton','ip2proxy','ipvanish','nordvpn'].includes(vpn.id) ? 'webp' : 'png'}`} alt={vpn.name} class="h-14 w-auto self-center" />
                </div>
              </div>
              <div class="pt-3 border-t border-slate-800 text-right">
                <span class="text-sm text-emerald-400 group-hover:text-emerald-300 transition-colors">查看详情 →</span>
              </div>
            </a>
          </div>
        );
      })}
    </div>

    <div id="pagination" class="flex items-center justify-center gap-3 mt-8 text-sm flex-wrap">
      <div class="flex items-center gap-2 text-slate-400 mr-2">
        <span>每页</span>
        <select id="page-size" class="bg-slate-800 border border-slate-700 rounded-lg px-2 py-1.5 text-slate-200 focus:outline-none focus:border-emerald-500 cursor-pointer">
          <option value="10">10</option>
          <option value="20">20</option>
          <option value="50">50</option>
        </select>
      </div>
      <button id="first-page" class="px-3 py-2 bg-slate-800 border border-slate-700 rounded-lg text-slate-300 hover:bg-slate-700 disabled:opacity-40 disabled:cursor-not-allowed transition-all" disabled>首页</button>
      <button id="prev-page" class="px-3 py-2 bg-slate-800 border border-slate-700 rounded-lg text-slate-300 hover:bg-slate-700 disabled:opacity-40 disabled:cursor-not-allowed transition-all" disabled>上一页</button>
      <span id="page-info" class="text-slate-400 px-2">第 1 页 / 共 1 页</span>
      <button id="next-page" class="px-3 py-2 bg-slate-800 border border-slate-700 rounded-lg text-slate-300 hover:bg-slate-700 disabled:opacity-40 disabled:cursor-not-allowed transition-all">下一页</button>
      <button id="last-page" class="px-3 py-2 bg-slate-800 border border-slate-700 rounded-lg text-slate-300 hover:bg-slate-700 disabled:opacity-40 disabled:cursor-not-allowed transition-all" disabled>末页</button>
    </div>
  </div>
</Layout>

<script>
  const allCards = document.querySelectorAll('.vpn-card');
  const totalSpan = document.getElementById('total-count');
  const pageSizeSelect = document.getElementById('page-size');
  const pageInfo = document.getElementById('page-info');
  const firstBtn = document.getElementById('first-page');
  const prevBtn = document.getElementById('prev-page');
  const nextBtn = document.getElementById('next-page');
  const lastBtn = document.getElementById('last-page');
  const searchInput = document.getElementById('search-input');
  let visibleCards = [...allCards];
  let page = 1;
  let perPage = 10;

  function filterCards() {
    const q = searchInput.value.trim().toLowerCase();
    visibleCards = [...allCards].filter(card => !q || card.dataset.name.includes(q));
    page = 1;
    showPage();
  }

  function showPage() {
    const total = visibleCards.length;
    allCards.forEach(card => card.style.display = 'none');
    visibleCards.forEach((card, i) => {
      if (i >= (page - 1) * perPage && i < page * perPage) {
        card.style.display = '';
      }
    });
    totalSpan.textContent = total;
    const totalPages = Math.ceil(total / perPage) || 1;
    pageInfo.textContent = `第 ${page} 页 / 共 ${totalPages} 页`;
    firstBtn.disabled = page <= 1;
    prevBtn.disabled = page <= 1;
    nextBtn.disabled = page >= totalPages;
    lastBtn.disabled = page >= totalPages;
  }

  searchInput.addEventListener('input', filterCards);
  pageSizeSelect.addEventListener('change', () => {
    perPage = parseInt(pageSizeSelect.value);
    page = 1;
    showPage();
  });

  firstBtn.addEventListener('click', () => { page = 1; showPage(); });
  prevBtn.addEventListener('click', () => { if (page > 1) { page--; showPage(); } });
  nextBtn.addEventListener('click', () => {
    const totalPages = Math.ceil(visibleCards.length / perPage) || 1;
    if (page < totalPages) { page++; showPage(); }
  });
  lastBtn.addEventListener('click', () => { page = Math.ceil(visibleCards.length / perPage) || 1; showPage(); });

  showPage();
</script>
