---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<Layout title="Proxy-Cheap 海外代理深度评测 - GlobalNet Labs">
  <div class="max-w-[1440px] mx-auto px-6 py-12">
    <div class="max-w-4xl mx-auto">
      <a href={`${base}/proxy`} class="text-sm text-emerald-400 hover:text-emerald-300 transition-colors inline-flex items-center gap-1 mb-6">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        返回代理列表
      </a>

      <div class="flex items-center gap-4 mb-10">
        <img src={`${base}/images/proxy-cheap.png`} alt="Proxy-Cheap" class="h-14 w-auto" />
        <div>
          <h1 class="text-3xl md:text-4xl font-bold text-slate-100 mb-1">Proxy-Cheap 深度评测</h1>
          <p class="text-slate-400 text-lg">高性价比代理，数据中心IPv6低至$0.15/月，全中文支持+支付宝，45000+客户信赖</p>
