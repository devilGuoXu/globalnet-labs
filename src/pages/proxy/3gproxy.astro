            <p class="text-slate-100 font-bold text-xl mt-1">€399</p>
            <p class="text-xs text-slate-500">20 GB</p>
          </div>
          <div class="bg-slate-950/50 rounded-xl p-4 border border-slate-700/50 text-center">
