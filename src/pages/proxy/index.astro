<script>
  const allCards = document.querySelectorAll('.proxy-card');
  const totalSpan = document.getElementById('total-count');
  const pageSizeSelect = document.getElementById('page-size');
  const pageInfo = document.getElementById('page-info');
  const firstBtn = document.getElementById('first-page');
  const prevBtn = document.getElementById('prev-page');
  const nextBtn = document.getElementById('next-page');
  const lastBtn = document.getElementById('last-page');
  const searchInput = document.getElementById('search-input');
  let visibleCards = [...allCards];
  let page = 1;
  let perPage = 10;

  const saved = sessionStorage.getItem('proxyListState');
  if (saved) {
    const st = JSON.parse(saved);
    page = st.page || 1;
    perPage = st.perPage || 10;
    if (st.search) searchInput.value = st.search;
    pageSizeSelect.value = perPage;
    sessionStorage.removeItem('proxyListState');
  }

  function saveState() {
    sessionStorage.setItem('proxyListState', JSON.stringify({
      page, perPage, search: searchInput.value.trim()
    }));
  }

  document.querySelectorAll('.proxy-card a').forEach(a => {
    a.addEventListener('click', saveState);
  });

  function filterCards() {
    const q = searchInput.value.trim().toLowerCase();
    visibleCards = [...allCards].filter(card => !q || card.dataset.name.includes(q));
    page = 1;
    showPage();
  }

  function showPage() {
    const total = visibleCards.length;
    allCards.forEach(card => card.style.display = 'none');
    visibleCards.forEach((card, i) => {
      if (i >= (page - 1) * perPage && i < page * perPage) {
        card.style.display = '';
      }
    });
    totalSpan.textContent = total;
    const totalPages = Math.ceil(total / perPage) || 1;
    pageInfo.textContent = `第 ${page} 页 / 共 ${totalPages} 页`;
    firstBtn.disabled = page <= 1;
    prevBtn.disabled = page <= 1;
    nextBtn.disabled = page >= totalPages;
    lastBtn.disabled = page >= totalPages;
  }

  searchInput.addEventListener('input', filterCards);
  pageSizeSelect.addEventListener('change', () => {
    perPage = parseInt(pageSizeSelect.value);
    page = 1;
    showPage();
  });

  firstBtn.addEventListener('click', () => { page = 1; showPage(); });
  prevBtn.addEventListener('click', () => { if (page > 1) { page--; showPage(); } });
  nextBtn.addEventListener('click', () => {
    const totalPages = Math.ceil(visibleCards.length / perPage) || 1;
    if (page < totalPages) { page++; showPage(); }
  });
  lastBtn.addEventListener('click', () => { page = Math.ceil(visibleCards.length / perPage) || 1; showPage(); });

  showPage();
</script>
