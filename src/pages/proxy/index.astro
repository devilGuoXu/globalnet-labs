---
import Layout from '../../layouts/Layout.astro';
import proxiesData from '../../data/proxies.json';
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<Layout title="海外住宅 / 移动代理厂商全览 - GlobalNet Labs">
  <div class="max-w-[1440px] mx-auto px-6 py-12">
    <h1 class="text-3xl md:text-4xl font-bold text-slate-100 mb-3">海外住宅 / 移动代理厂商全览</h1>
    <p class="text-slate-400 mb-10">全球住宅代理与移动代理资源聚合，覆盖跨境数据采集、社媒运营与风控规避场景。</p>

    <div class="grid md:grid-cols-2 gap-4">
      {proxiesData.map((proxy) => {
        const isExternal = proxy.detailUrl.startsWith('http');
        return (
          <a href={isExternal ? proxy.detailUrl : `${base}${proxy.detailUrl}`} target={isExternal ? '_blank' : undefined} rel={isExternal ? 'noopener noreferrer' : undefined} class="bg-slate-900 border border-slate-800 rounded-xl p-5 hover:border-emerald-500/30 transition-all duration-300 group block">
            <div class="flex items-start justify-between mb-3">
              <div class="flex items-center gap-3">
                <h3 class="text-base font-semibold text-slate-100 group-hover:text-emerald-400 transition-colors">{proxy.name}</h3>
                {proxy.badge && (
                  <span class="text-xs text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-full border border-emerald-500/20">{proxy.badge}</span>
                )}
              </div>
              <span class="flex items-center gap-1 text-amber-400 text-sm shrink-0">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                {proxy.rating}
              </span>
            </div>
            <p class="text-sm text-slate-400 mb-3"><span class="text-slate-500">IP池：</span>{proxy.poolSize} · {proxy.proxyTypes?.join('、')}</p>
            <div class="flex gap-4 mb-4">
              <ul class="space-y-1 flex-1">
                {proxy.features.map((f) => (
                  <li class="flex items-center gap-2 text-sm text-slate-300">
                    <svg class="w-3.5 h-3.5 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    {f}
                  </li>
                ))}
              </ul>
              {(proxy.id === 'netnut' || proxy.id === 'soax') && (
                <img src={`${base}/images/${proxy.id}.png`} alt={proxy.name} class="h-14 w-auto self-center" />
              )}
            </div>
            <div class="pt-3 border-t border-slate-800 text-right">
              <span class="text-sm text-emerald-400 group-hover:text-emerald-300 transition-colors">查看详情 →</span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</Layout>
